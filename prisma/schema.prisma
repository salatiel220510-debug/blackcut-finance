// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  BARBER
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(BARBER)
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  needsAccessCode Boolean @default(false)

  servicosRealizados  Transaction[] @relation("Barbeiro")
  transacoesCriadas   Transaction[] @relation("CriadoPor")
  transacoesExcluidas Transaction[] @relation("ExcluidoPor")

  @@index([status])
  @@index([role])

  pushSubscriptions   PushSubscription[]
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  category    String
  description String?
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime        @default(now())

  barberId             String?
  barber               User?    @relation("Barbeiro", fields: [barberId], references: [id])
  commissionPercentage Decimal? @db.Decimal(5, 2)
  commissionAmount     Decimal? @db.Decimal(10, 2)

  createdById String
  createdBy   User     @relation("CriadoPor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ExcluidoPor", fields: [deletedById], references: [id])

  @@index([date])
  @@index([barberId])
  @@index([type])
  @@index([deletedAt])
}

model Settings {
  id                   Int       @id @default(1)
  commissionPercentage Decimal   @default(40.00) @db.Decimal(5, 2)
  saldoBancario        Decimal   @default(0) @db.Decimal(10, 2)
  accessCode           String?
  accessCodeUpdatedAt  DateTime?
  updatedAt            DateTime  @updatedAt
}

model ServiceType {
  id                 String    @id @default(cuid())
  name               String    @unique
  price              Decimal?  @db.Decimal(10, 2)
  discountPercentage Decimal?  @db.Decimal(5, 2)
  discountValidUntil DateTime?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}