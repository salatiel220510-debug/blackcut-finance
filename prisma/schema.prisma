generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  BARBER
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ExpenseCategoryType {
  FIXED
  VARIABLE
  INVESTMENT
  MARKETING
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
}

model User {
  id              String        @id @default(cuid())
  name            String
  email           String        @unique
  passwordHash    String
  role            Role          @default(BARBER)
  status          AccountStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  needsAccessCode Boolean       @default(false)

  servicosRealizados    Transaction[]          @relation("Barbeiro")
  transacoesCriadas     Transaction[]          @relation("CriadoPor")
  transacoesExcluidas   Transaction[]          @relation("ExcluidoPor")
  pushSubscriptions     PushSubscription[]
  comissoesLiquidadas   CommissionSettlement[] @relation("ComissoesLiquidadas")
  liquidacoesRealizadas CommissionSettlement[] @relation("LiquidacoesRealizadas")

  @@index([status])
  @@index([role])
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  category    String
  description String?
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime        @default(now())

  barberId             String?
  barber               User?    @relation("Barbeiro", fields: [barberId], references: [id])
  commissionPercentage Decimal? @db.Decimal(5, 2)
  commissionAmount     Decimal? @db.Decimal(10, 2)
  commissionSettled    Boolean  @default(false)

  expenseCategoryId String?
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id])

  comandaId     String?
  paymentMethod PaymentMethod?
  clienteNome   String?

  createdById String
  createdBy   User     @relation("CriadoPor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ExcluidoPor", fields: [deletedById], references: [id])

  liquidacaoComoDespesa CommissionSettlement? @relation("DespesaDaLiquidacao")

  @@index([date])
  @@index([barberId])
  @@index([type])
  @@index([deletedAt])
  @@index([expenseCategoryId])
  @@index([comandaId])
  @@index([commissionSettled])
}

model Settings {
  id                     Int       @id @default(1)
  commissionPercentage   Decimal   @default(40.00) @db.Decimal(5, 2)
  saldoBancario          Decimal   @default(0) @db.Decimal(10, 2)
  accessCode             String?
  accessCodeUpdatedAt    DateTime?

  envelopesEnabled       Boolean   @default(true)
  envelopeOperacionalPct Decimal   @default(60) @db.Decimal(5, 2)
  envelopeProLaborePct   Decimal   @default(30) @db.Decimal(5, 2)
  envelopeReservaPct     Decimal   @default(10) @db.Decimal(5, 2)
  proLaboreMeta          Decimal?  @db.Decimal(10, 2)
  reservaMeta            Decimal?  @db.Decimal(10, 2)

  updatedAt              DateTime  @updatedAt
}

model ServiceType {
  id                 String    @id @default(cuid())
  name               String    @unique
  price              Decimal?  @db.Decimal(10, 2)
  discountPercentage Decimal?  @db.Decimal(5, 2)
  discountValidUntil DateTime?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ExpenseCategory {
  id          String              @id @default(cuid())
  name        String              @unique
  type        ExpenseCategoryType
  budgetLimit Decimal?            @db.Decimal(10, 2)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

    transacoes  Transaction[]
  alertas     BudgetAlert[]

  @@index([type])
}

model MonthlyClosure {
  id                     String   @id @default(cuid())
  mes                    DateTime
  faturamentoBruto       Decimal  @db.Decimal(10, 2)
  totalDespesasFixas     Decimal  @db.Decimal(10, 2)
  totalDespesasVariaveis Decimal  @db.Decimal(10, 2)
  totalInvestimento      Decimal  @db.Decimal(10, 2)
  totalMarketing         Decimal  @db.Decimal(10, 2)
  totalDespesas          Decimal  @db.Decimal(10, 2)
  totalComissoes         Decimal  @db.Decimal(10, 2)
  lucroLiquido           Decimal  @db.Decimal(10, 2)
  envelopeOperacional    Decimal  @db.Decimal(10, 2)
  envelopeProLabore      Decimal  @db.Decimal(10, 2)
  envelopeReserva        Decimal  @db.Decimal(10, 2)
  createdAt              DateTime @default(now())

  @@unique([mes])
}

model CommissionSettlement {
  id                   String       @id @default(cuid())
  barberId             String
  barber               User         @relation("ComissoesLiquidadas", fields: [barberId], references: [id])
  totalAcumulado       Decimal      @db.Decimal(10, 2)
  valorPago            Decimal      @db.Decimal(10, 2)
  valorAbsorvido       Decimal      @db.Decimal(10, 2)
  expenseTransactionId String?      @unique
  expenseTransaction   Transaction? @relation("DespesaDaLiquidacao", fields: [expenseTransactionId], references: [id])
  paidById             String
  paidBy               User         @relation("LiquidacoesRealizadas", fields: [paidById], references: [id])
  createdAt            DateTime     @default(now())

  @@index([barberId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

enum BudgetAlertLevel {
  ATENCAO
  ESTOURADO
}

model BudgetAlert {
  id                String           @id @default(cuid())
  expenseCategoryId String
  expenseCategory   ExpenseCategory  @relation(fields: [expenseCategoryId], references: [id])
  mes               DateTime
  level             BudgetAlertLevel
  createdAt         DateTime         @default(now())

  @@unique([expenseCategoryId, mes, level])
}